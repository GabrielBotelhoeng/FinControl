{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/entrar",
      "destination": "/app.html"
    },
    {
      "source": "/lancamentos",
      "destination": "/app.html"
    },
    {
      "source": "/importar",
      "destination": "/app.html"
    },
    {
      "source": "/contas",
      "destination": "/app.html"
    },
    {
      "source": "/cartoes/:id",
      "destination": "/app.html"
    },
    {
      "source": "/emprestimos",
      "destination": "/app.html"
    },
    {
      "source": "/emprestimos/:id",
      "destination": "/app.html"
    },
    {
      "source": "/dividas",
      "destination": "/app.html"
    },
    {
      "source": "/dividas/plano",
      "destination": "/app.html"
    },
    {
      "source": "/dividas/:id",
      "destination": "/app.html"
    },
    {
      "source": "/patrimonio",
      "destination": "/app.html"
    },
    {
      "source": "/calendario",
      "destination": "/app.html"
    },
    {
      "source": "/planejamento",
      "destination": "/app.html"
    },
    {
      "source": "/relatorios",
      "destination": "/app.html"
    },
    {
      "source": "/resumo",
      "destination": "/app.html"
    },
    {
      "source": "/notificacoes",
      "destination": "/app.html"
    },
    {
      "source": "/assistente",
      "destination": "/app.html"
    },
    {
      "source": "/categorias",
      "destination": "/app.html"
    },
    {
      "source": "/perfil",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://fincontrol-api-gb.vercel.app https://ojywswdjhjmwnfhalntl.supabase.co; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    }
  ]
}
