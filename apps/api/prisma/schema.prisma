generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ThemePreference {
  light
  dark
  system
}

enum AccountType {
  checking
  savings
  wallet
  investment
  credit_card
}

enum CategoryType {
  income
  expense
}

enum TransactionType {
  income
  expense
  transfer
}

enum TransactionNature {
  fixed
  variable
}

enum TransactionStatus {
  pending
  paid
}

enum LoanKind {
  personal
  payroll_inss
  payroll_public
  payroll_private
  vehicle
  mortgage
  other
}

enum Frequency {
  weekly
  monthly
  yearly
}

model Profile {
  id           String          @id @db.Uuid
  name         String
  isDemo       Boolean         @default(false) @map("is_demo")
  theme        ThemePreference @default(system)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz
  accounts     Account[]
  categories   Category[]
  recurrences  Recurrence[]
  transactions Transaction[]
  loans        Loan[]

  @@index([isDemo, createdAt])
  @@map("profiles")
}

model Account {
  id                      String        @id @default(uuid()) @db.Uuid
  userId                  String        @map("user_id") @db.Uuid
  name                    String
  type                    AccountType
  color                   String
  initialBalance          BigInt        @default(0) @map("initial_balance")
  creditLimit             BigInt?       @map("credit_limit")
  closingDay              Int?          @map("closing_day")
  dueDay                  Int?          @map("due_day")
  paymentAccountId        String?       @map("payment_account_id") @db.Uuid
  archivedAt              DateTime?     @map("archived_at") @db.Timestamptz
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  user                    Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccount          Account?      @relation("AccountPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  transactions            Transaction[] @relation("TransactionAccount")
  incomingTransfers       Transaction[] @relation("TransactionDestination")
  recurrences             Recurrence[]  @relation("RecurrenceAccount")
  incomingRecurrences     Recurrence[]  @relation("RecurrenceDestination")
  cardsUsingThisAsPayment Account[]     @relation("AccountPaymentAccount")
  loans                   Loan[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String
  type         CategoryType
  icon         String
  color        String
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  user         Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurrences  Recurrence[]

  @@unique([userId, type, name])
  @@map("categories")
}

model Recurrence {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  frequency            Frequency
  startDate            DateTime           @map("start_date") @db.Date
  endDate              DateTime?          @map("end_date") @db.Date
  type                 TransactionType
  amount               BigInt
  description          String
  accountId            String             @map("account_id") @db.Uuid
  destinationAccountId String?            @map("destination_account_id") @db.Uuid
  categoryId           String?            @map("category_id") @db.Uuid
  nature               TransactionNature?
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  user                 Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account            @relation("RecurrenceAccount", fields: [accountId], references: [id], onDelete: NoAction)
  destinationAccount   Account?           @relation("RecurrenceDestination", fields: [destinationAccountId], references: [id], onDelete: NoAction)
  category             Category?          @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  transactions         Transaction[]
  skips                RecurrenceSkip[]

  @@index([userId])
  @@map("recurrences")
}

model RecurrenceSkip {
  id             String     @id @default(uuid()) @db.Uuid
  recurrenceId   String     @map("recurrence_id") @db.Uuid
  occurrenceDate DateTime   @map("occurrence_date") @db.Date
  recurrence     Recurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)

  @@unique([recurrenceId, occurrenceDate])
  @@map("recurrence_skips")
}

model Transaction {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  type                 TransactionType
  amount               BigInt
  description          String
  accountId            String             @map("account_id") @db.Uuid
  destinationAccountId String?            @map("destination_account_id") @db.Uuid
  categoryId           String?            @map("category_id") @db.Uuid
  nature               TransactionNature?
  status               TransactionStatus  @default(pending)
  dueDate              DateTime           @map("due_date") @db.Date
  paidDate             DateTime?          @map("paid_date") @db.Date
  recurrenceId         String?            @map("recurrence_id") @db.Uuid
  occurrenceDate       DateTime?          @map("occurrence_date") @db.Date
  invoiceMonth         DateTime?          @map("invoice_month") @db.Date
  installmentGroupId   String?            @map("installment_group_id") @db.Uuid
  installmentNumber    Int?               @map("installment_number")
  installmentTotal     Int?               @map("installment_total")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  user                 Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account            @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: NoAction)
  destinationAccount   Account?           @relation("TransactionDestination", fields: [destinationAccountId], references: [id], onDelete: NoAction)
  category             Category?          @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  recurrence           Recurrence?        @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  loanId               String?            @map("loan_id") @db.Uuid
  loan                 Loan?              @relation(fields: [loanId], references: [id], onDelete: SetNull)

  @@unique([recurrenceId, occurrenceDate])
  @@index([userId, dueDate])
  @@index([userId, paidDate])
  @@index([accountId, invoiceMonth])
  @@index([loanId])
  @@map("transactions")
}

/** Empréstimo ou financiamento (spec C8–C11). As parcelas restantes são lançamentos com `loanId`. */
model Loan {
  id                     String        @id @default(uuid()) @db.Uuid
  userId                 String        @map("user_id") @db.Uuid
  name                   String
  kind                   LoanKind
  bankName               String        @map("bank_name")
  bankCnpj8              String?       @map("bank_cnpj8") @db.Char(8)
  principal              BigInt
  installmentAmount      BigInt        @map("installment_amount")
  installmentsTotal      Int           @map("installments_total")
  installmentsPaidBefore Int           @default(0) @map("installments_paid_before")
  firstDueDate           DateTime      @map("first_due_date") @db.Date
  accountId              String        @map("account_id") @db.Uuid
  /** Fração ao mês, só para conferência. */
  informedMonthlyRate    Decimal?      @map("informed_monthly_rate") @db.Decimal(9, 6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  user                   Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                Account       @relation(fields: [accountId], references: [id], onDelete: NoAction)
  transactions           Transaction[]

  @@index([userId])
  @@map("loans")
}

/** Taxas do Banco Central (spec C12; D1: só o período mais recente de cada modalidade). Percentual, como publicado. */
model BankRate {
  id          String   @id @default(uuid()) @db.Uuid
  modality    String
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  institution String
  cnpj8       String   @db.Char(8)
  monthlyRate Decimal  @map("monthly_rate") @db.Decimal(9, 4)
  annualRate  Decimal  @map("annual_rate") @db.Decimal(9, 4)
  position    Int
  syncedAt    DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@unique([modality, cnpj8])
  @@index([cnpj8])
  @@map("bank_rates")
}
