generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ThemePreference {
  light
  dark
  system
}

enum AccountType {
  checking
  savings
  wallet
  investment
  credit_card
}

enum CategoryType {
  income
  expense
}

enum TransactionType {
  income
  expense
  transfer
}

enum TransactionNature {
  fixed
  variable
}

enum TransactionStatus {
  pending
  paid
}

enum LoanKind {
  personal
  payroll_inss
  payroll_public
  payroll_private
  vehicle
  mortgage
  other
}

enum DebtKind {
  bank
  store
  utility
  tax
  person
  other
}

enum DebtEventKind {
  valuation
  agreement
  note
}

enum Frequency {
  weekly
  monthly
  yearly
}

model Profile {
  id                String             @id @db.Uuid
  name              String
  isDemo            Boolean            @default(false) @map("is_demo")
  theme             ThemePreference    @default(system)
  /**
   * Preferências de notificação (spec do sub-projeto 5, N7); o que faltar vem dos padrões.
   */
  notificationPrefs Json               @default("{}") @map("notification_prefs")
  /**
   * Quando aceitou enviar dados ao assistente com IA (spec do assistente, A5); `null` = não aceitou.
   */
  aiConsentAt       DateTime?          @map("ai_consent_at") @db.Timestamptz
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  accounts          Account[]
  categories        Category[]
  recurrences       Recurrence[]
  transactions      Transaction[]
  loans             Loan[]
  budgets           Budget[]
  goals             Goal[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  aiUsage           AiUsage[]
  debts             Debt[]

  @@index([isDemo, createdAt])
  @@map("profiles")
}

model Account {
  id                      String        @id @default(uuid()) @db.Uuid
  userId                  String        @map("user_id") @db.Uuid
  name                    String
  type                    AccountType
  color                   String
  initialBalance          BigInt        @default(0) @map("initial_balance")
  creditLimit             BigInt?       @map("credit_limit")
  closingDay              Int?          @map("closing_day")
  dueDay                  Int?          @map("due_day")
  paymentAccountId        String?       @map("payment_account_id") @db.Uuid
  archivedAt              DateTime?     @map("archived_at") @db.Timestamptz
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  user                    Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentAccount          Account?      @relation("AccountPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  transactions            Transaction[] @relation("TransactionAccount")
  incomingTransfers       Transaction[] @relation("TransactionDestination")
  recurrences             Recurrence[]  @relation("RecurrenceAccount")
  incomingRecurrences     Recurrence[]  @relation("RecurrenceDestination")
  cardsUsingThisAsPayment Account[]     @relation("AccountPaymentAccount")
  loans                   Loan[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  name         String
  type         CategoryType
  icon         String
  color        String
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  user         Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurrences  Recurrence[]
  budgets      Budget[]

  @@unique([userId, type, name])
  @@map("categories")
}

model Recurrence {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  frequency            Frequency
  startDate            DateTime           @map("start_date") @db.Date
  endDate              DateTime?          @map("end_date") @db.Date
  type                 TransactionType
  amount               BigInt
  description          String
  accountId            String             @map("account_id") @db.Uuid
  destinationAccountId String?            @map("destination_account_id") @db.Uuid
  categoryId           String?            @map("category_id") @db.Uuid
  nature               TransactionNature?
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  user                 Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account            @relation("RecurrenceAccount", fields: [accountId], references: [id], onDelete: NoAction)
  destinationAccount   Account?           @relation("RecurrenceDestination", fields: [destinationAccountId], references: [id], onDelete: NoAction)
  category             Category?          @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  transactions         Transaction[]
  skips                RecurrenceSkip[]

  @@index([userId])
  @@map("recurrences")
}

model RecurrenceSkip {
  id             String     @id @default(uuid()) @db.Uuid
  recurrenceId   String     @map("recurrence_id") @db.Uuid
  occurrenceDate DateTime   @map("occurrence_date") @db.Date
  recurrence     Recurrence @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)

  @@unique([recurrenceId, occurrenceDate])
  @@map("recurrence_skips")
}

model Transaction {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  type                 TransactionType
  amount               BigInt
  description          String
  accountId            String             @map("account_id") @db.Uuid
  destinationAccountId String?            @map("destination_account_id") @db.Uuid
  categoryId           String?            @map("category_id") @db.Uuid
  nature               TransactionNature?
  status               TransactionStatus  @default(pending)
  dueDate              DateTime           @map("due_date") @db.Date
  paidDate             DateTime?          @map("paid_date") @db.Date
  recurrenceId         String?            @map("recurrence_id") @db.Uuid
  occurrenceDate       DateTime?          @map("occurrence_date") @db.Date
  invoiceMonth         DateTime?          @map("invoice_month") @db.Date
  installmentGroupId   String?            @map("installment_group_id") @db.Uuid
  installmentNumber    Int?               @map("installment_number")
  installmentTotal     Int?               @map("installment_total")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  user                 Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account              Account            @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: NoAction)
  destinationAccount   Account?           @relation("TransactionDestination", fields: [destinationAccountId], references: [id], onDelete: NoAction)
  category             Category?          @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  recurrence           Recurrence?        @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  loanId               String?            @map("loan_id") @db.Uuid
  loan                 Loan?              @relation(fields: [loanId], references: [id], onDelete: SetNull)
  /**
   * Pagamento de uma dívida com credor (sub-projeto 6, V1): avulso, ou parcela de acordo quando tem `installmentNumber`.
   */
  debtId               String?            @map("debt_id") @db.Uuid
  debt                 Debt?              @relation(fields: [debtId], references: [id], onDelete: SetNull)

  @@unique([recurrenceId, occurrenceDate])
  @@index([userId, dueDate])
  @@index([userId, paidDate])
  @@index([accountId, invoiceMonth])
  @@index([loanId])
  @@index([debtId])
  @@map("transactions")
}

/**
 * Empréstimo ou financiamento (spec C8–C11). As parcelas restantes são lançamentos com `loanId`.
 */
model Loan {
  id                     String        @id @default(uuid()) @db.Uuid
  userId                 String        @map("user_id") @db.Uuid
  name                   String
  kind                   LoanKind
  bankName               String        @map("bank_name")
  bankCnpj8              String?       @map("bank_cnpj8") @db.Char(8)
  principal              BigInt
  installmentAmount      BigInt        @map("installment_amount")
  installmentsTotal      Int           @map("installments_total")
  installmentsPaidBefore Int           @default(0) @map("installments_paid_before")
  firstDueDate           DateTime      @map("first_due_date") @db.Date
  accountId              String        @map("account_id") @db.Uuid
  /**
   * Fração ao mês, só para conferência.
   */
  informedMonthlyRate    Decimal?      @map("informed_monthly_rate") @db.Decimal(9, 6)
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  user                   Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account                Account       @relation(fields: [accountId], references: [id], onDelete: NoAction)
  transactions           Transaction[]

  @@index([userId])
  @@map("loans")
}

/**
 * Taxas do Banco Central (spec C12; D1: só o período mais recente de cada modalidade). Percentual, como publicado.
 */
model BankRate {
  id          String   @id @default(uuid()) @db.Uuid
  modality    String
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  institution String
  cnpj8       String   @db.Char(8)
  monthlyRate Decimal  @map("monthly_rate") @db.Decimal(9, 4)
  annualRate  Decimal  @map("annual_rate") @db.Decimal(9, 4)
  position    Int
  syncedAt    DateTime @default(now()) @map("synced_at") @db.Timestamptz

  @@unique([modality, cnpj8])
  @@index([cnpj8])
  @@map("bank_rates")
}

/**
 * Limite mensal de uma categoria de despesa (sub-projeto 3, P1): vale para todos os meses.
 */
model Budget {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  limitAmount BigInt   @map("limit_amount")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@map("budgets")
}

/**
 * Objetivo de economia (P6): o progresso vem dos depósitos, que não mexem em saldo de conta.
 */
model Goal {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  name          String
  targetAmount  BigInt             @map("target_amount")
  targetDate    DateTime           @map("target_date") @db.Date
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  user          Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId])
  @@map("goals")
}

/**
 * Depósito (positivo) ou retirada (negativo) numa meta.
 */
model GoalContribution {
  id        String   @id @default(uuid()) @db.Uuid
  goalId    String   @map("goal_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    BigInt
  date      DateTime @db.Date
  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_contributions")
}

/**
 * Memória de cada aviso (spec do sub-projeto 5, N2 e N3): o aviso em si é calculado na hora.
 */
model Notification {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  key          String    @db.VarChar(200)
  firstSeenAt  DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz
  lastActiveAt DateTime  @default(now()) @map("last_active_at") @db.Timestamptz
  readAt       DateTime? @map("read_at") @db.Timestamptz
  /**
   * Parte B (W2): quando foi enviado por push; cada aviso vai uma vez só.
   */
  pushedAt     DateTime? @map("pushed_at") @db.Timestamptz
  user         Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([lastActiveAt])
  @@map("notifications")
}

/**
 * Assinatura de Web Push de um navegador (spec do sub-projeto 5, Parte B, W6): o endereço é único.
 */
model PushSubscription {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  endpoint      String    @unique @db.VarChar(1000)
  p256dh        String    @db.VarChar(200)
  auth          String    @db.VarChar(100)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSuccessAt DateTime? @map("last_success_at") @db.Timestamptz
  user          Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/**
 * Uso do assistente por pessoa e dia (spec do assistente, A9): o limite vale entre instâncias da função e o gasto
 * de tokens fica registrado. `day` é a data de São Paulo.
 */
model AiUsage {
  userId       String   @map("user_id") @db.Uuid
  day          DateTime @db.Date
  requests     Int      @default(0)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  user         Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
  @@map("ai_usage")
}

/**
 * Dívida com qualquer credor (sub-projeto 6). O saldo é sempre calculado (V3): âncoras em `debt_events`
 * e pagamentos em `transactions.debt_id`.
 */
model Debt {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  name           String
  creditor       String
  kind           DebtKind
  originalAmount BigInt        @map("original_amount")
  since          DateTime      @db.Date
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  user           Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  events         DebtEvent[]
  transactions   Transaction[]

  @@index([userId])
  @@map("debts")
}

/**
 * Atualização de valor e acordo (âncoras, V3/V7) ou negociação (V5). Os campos do acordo só valem em `agreement`.
 */
model DebtEvent {
  id                String        @id @default(uuid()) @db.Uuid
  debtId            String        @map("debt_id") @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  kind              DebtEventKind
  date              DateTime      @db.Date
  amount            BigInt?
  note              String?
  downPayment       BigInt?       @map("down_payment")
  installments      Int?
  installmentAmount BigInt?       @map("installment_amount")
  cancelledAt       DateTime?     @map("cancelled_at") @db.Timestamptz
  recordedAt        DateTime      @default(now()) @map("recorded_at") @db.Timestamptz
  debt              Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@index([debtId])
  @@map("debt_events")
}
