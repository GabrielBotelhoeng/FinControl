NODE_ENV=development
PORT=3333
LOG_LEVEL=info
# Local (docker compose). Em produção: string do pooler do Supabase.
DATABASE_URL=postgresql://fincontrol:fincontrol@localhost:5435/fincontrol_dev
# Produção: PEM da CA do Supabase (prod-ca-2021.crt). Com ela, a conexão valida certificado e host.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----..."
# Conexão direta, usada pelas migrations do Prisma.
DIRECT_URL=postgresql://fincontrol:fincontrol@localhost:5435/fincontrol_dev
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=coloque-a-service-role-key
WEB_ORIGIN=http://localhost:5173
# Opcional: regex (ancorada) das URLs de preview da web que também podem chamar a API.
# WEB_PREVIEW_ORIGIN_PATTERN=https://fincontrol-(?:web-git-[a-z0-9-]+|[a-z0-9]+)-gabriel-botelhos-projects\.vercel\.app
CRON_SECRET=troque-em-producao-por-openssl-rand-hex-32
